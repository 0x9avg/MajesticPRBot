# ==============================================================================
# PRMajesticBot API Configuration
# ==============================================================================

# Application Settings
ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prmajesticbot

# Security / JWT
# MUST match DISCORD_TOKEN if not explicitly set
JWT_SECRET_KEY=changeme 

# RabbitMQ Settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Integration Settings
WEB_PANEL_URL=http://localhost:5173
GUILD_ID=0
