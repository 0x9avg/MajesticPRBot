ENV=production
API_HOST=0.0.0.0
API_PORT=8000

DB_HOST=mysql
DB_PORT=3306
DB_USER=prmajesticbot
DB_PASSWORD=replace_with_mysql_app_password
DB_NAME=prmajesticbot

JWT_SECRET_KEY=replace_with_a_64_character_random_secret
SERVICE_TOKENS=discord_service:replace_with_discord_service_token,twitch_service:replace_with_twitch_service_token

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=prmajesticbot
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
RABBITMQ_VHOST=prmajesticbot

WEB_PANEL_URL=https://panel.example.com
COOKIE_SECURE=true
COOKIE_DOMAIN=

LOG_LEVEL=INFO
